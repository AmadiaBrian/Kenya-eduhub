RewriteEngine On

# Disable directory listing
Options -Indexes

# Allow direct access to api directory
RewriteRule ^api/ - [L]

# Allow direct access to b2c directory
RewriteRule ^b2c/ - [L]

# Allow direct access to config directory
RewriteRule ^config/ - [L]

# Allow direct access to receipts directory
RewriteRule ^receipts/ - [L]

# Allow direct access to report_files directory
RewriteRule ^report_files/ - [L]

# Remove trailing slash from URLs
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} (.+)/$
RewriteRule ^ %1 [L,R=301]

# Redirect requests with .php extension to clean URLs
RewriteCond %{THE_REQUEST} /([^.]+)\.php [NC]
RewriteRule ^ %1 [L,R=302]

# Route all requests to index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)$ index.php?route=$1 [L,QSA]
